# Neon PostgreSQL
# Dashboard → Connection details → copy "Connection string"
# Prefer the non-pooled (direct) URL for migrations; pooled also works for the app.
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# LLM — OpenAI-compatible API (Ollama local example below)
# Ollama: http://127.0.0.1:11434/v1  model e.g. llama3.2
# Cloud:  https://api.openai.com/v1   model e.g. gpt-4o-mini
LLM_BASE_URL="http://127.0.0.1:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="llama3.2"
